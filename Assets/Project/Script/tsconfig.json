{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ES2022",
    "lib": [
      "ES2023"
    ],
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true,
    "typeRoots": [
      "../../../node_modules/@types"
    ],
    "types": [
      "cluster-script"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}
